{
  "name": "wezterm-ssh-manager-opentui",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun --bun src/index.tsx",
    "start": "bun --bun src/index.tsx",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "build": "bun run scripts/build.ts",
    "build:all": "bun run scripts/build.ts --target all",
    "package": "bun run scripts/package.ts"
  },
  "dependencies": {
    "@opentui/core": "0.5.9",
    "@opentui/solid": "0.5.9",
    "solid-js": "1.9.12",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.5",
    "@types/ssh2": "1.15.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
